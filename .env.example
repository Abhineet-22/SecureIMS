# Generate a key with:  python -m app.cli gen-key
INV_MASTER_KEY=YOUR_BASE64URL_32BYTE_KEY_HERE
INV_ENV=development            # production => docs disabled, strict checks
INV_DATABASE_URL=sqlite:///./inventory.db
INV_CORS_ORIGINS=["http://localhost:3000"]
INV_ALLOWED_HOSTS=["localhost","127.0.0.1"]
INV_TIMEZONE=Asia/Kolkata
